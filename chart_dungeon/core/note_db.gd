static func name_of(id: String) -> String:
	return ENTRIES.get(id, {}).get("name", id)


static func ids_in(chapter: String) -> Array[String]:
	var list: Array[String] = []
	for id: String in ENTRIES:
		if ENTRIES[id]["chapter"] == chapter and ENTRIES[id]["texts"][0] != "":
			list.append(id)
	return list


static func total() -> int:
	var count := 0
	for id: String in ENTRIES:
		if ENTRIES[id]["texts"][0] != "":
			count += 1
	return count
